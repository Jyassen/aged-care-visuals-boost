# Email Configuration for Contact Form using Resend
# Copy this file to .env.local and fill in your actual values

# HighLevel (GoHighLevel) — Medicare Starter Kit leads → YourMedGuy sub-account only
# Preferred: Inbound Webhook URL from a workflow in the YourMedGuy location (no key needed)
GHL_STARTER_KIT_WEBHOOK_URL=
# Fallback only if no webhook: Private Integration token (contacts.write, contacts.readonly, opportunities.write)
GHL_PRIVATE_TOKEN=
# Defaults to the YourMedGuy location 1sUU5Trz1pkSpCoWcRwr; override only if that ever changes
GHL_LOCATION_ID=
# API path only: "true" creates a New Lead opportunity; leave unset if the Marketing Lead Workflow already does
GHL_CREATE_OPPORTUNITY=

# Resend configuration
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=noreply@yourdomain.com
TO_EMAIL=your-actual-email@gmail.com