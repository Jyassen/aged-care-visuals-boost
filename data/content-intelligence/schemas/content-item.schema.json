{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the content item"
    },
    "source": {
      "type": "string",
      "enum": ["youtube", "facebook", "instagram", "competitor"],
      "description": "Source platform type"
    },
    "platform": {
      "type": "string",
      "description": "Specific platform or website name"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "URL of the content"
    },
    "title": {
      "type": "string",
      "description": "Title of the content"
    },
    "content": {
      "type": "string",
      "description": "Full text content or transcript"
    },
    "publishedDate": {
      "type": "string",
      "format": "date-time",
      "description": "Original publication date"
    },
    "collectedDate": {
      "type": "string",
      "format": "date-time",
      "description": "Date when content was collected"
    },
    "engagement": {
      "type": "object",
      "properties": {
        "views": {
          "type": "number"
        },
        "likes": {
          "type": "number"
        },
        "comments": {
          "type": "number"
        },
        "shares": {
          "type": "number"
        },
        "engagementRate": {
          "type": "number"
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "duration": {
          "type": "number",
          "description": "Duration in seconds for video content"
        },
        "format": {
          "type": "string",
          "enum": ["video", "post", "article", "ad", "page"],
          "description": "Content format type"
        },
        "visualStyle": {
          "type": "string",
          "description": "Description of visual styling"
        },
        "cta": {
          "type": "string",
          "description": "Call-to-action text"
        },
        "author": {
          "type": "string",
          "description": "Content author or creator"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extracted themes from content"
    },
    "messagingPatterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Identified messaging patterns"
    }
  },
  "required": ["id", "source", "platform", "url", "title", "content", "collectedDate", "themes", "messagingPatterns"]
}

